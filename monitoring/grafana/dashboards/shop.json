{
  "uid": "shop",
  "title": "Shop",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by endpoint and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, status) (rate(http_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "{{method}} {{endpoint}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (% of requests with 5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency p95 / p99 (histogram, 5m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "p99 {{endpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average create-order time (summary, 1m window)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(order_request_seconds_sum[1m]) / rate(order_request_seconds_count[1m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "average"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Orders placed per minute by product",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (product) (increase(orders_placed_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "{{product}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Orders awaiting shipment (gauge)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orders_awaiting_shipment",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "awaiting shipment"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Payment failures and cancellations per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(payment_failures_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "payment failures"
        },
        {
          "refId": "B",
          "expr": "sum(increase(orders_cancelled_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "cancellations"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Revenue per minute by product ($)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (product) (increase(revenue_dollars_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "{{product}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU busy % (docker-desktop-vm)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memory used % (docker-desktop-vm)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "memory %"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk used % – Docker data disk (docker-desktop-vm)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/mnt/docker-desktop-disk\"} / node_filesystem_size_bytes{mountpoint=\"/mnt/docker-desktop-disk\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "disk %"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Network bytes/s (docker-desktop-vm)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "receive"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "transmit"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Place order calls/s: HTTP POST /orders by status vs gRPC PlaceOrder by code",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{method=\"POST\", endpoint=\"/orders\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "HTTP {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (method, code) (rate(grpc_server_handled_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "gRPC {{code}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Place order error rate %: HTTP (non-2xx) vs gRPC (non-OK)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{method=\"POST\", endpoint=\"/orders\", status!~\"2..\"}[1m])) / sum(rate(http_requests_total{method=\"POST\", endpoint=\"/orders\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "HTTP"
        },
        {
          "refId": "B",
          "expr": "100 * sum by (method) (rate(grpc_server_handled_total{code!=\"OK\"}[1m])) / sum by (method) (rate(grpc_server_handled_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "gRPC {{method}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Place order p50 / p95 (server side, 5m window): HTTP vs gRPC",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{method=\"POST\", endpoint=\"/orders\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "HTTP p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{method=\"POST\", endpoint=\"/orders\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "HTTP p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (le, method) (rate(grpc_server_handling_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "gRPC p50"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(grpc_server_handling_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "gRPC p95"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "In-flight calls: HTTP vs gRPC",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "http_requests_in_flight",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "HTTP"
        },
        {
          "refId": "B",
          "expr": "sum by (method) (grpc_server_in_flight)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "gRPC {{method}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Payment provider p95 (5m window, both services)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(payment_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "payment p95"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Rate-limited requests/s (429)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=\"429\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "legendFormat": "429/s"
        }
      ]
    }
  ]
}